<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:windowSoftInputMode="stateAlwaysHidden">

        <TextView android:id="@+id/clue_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:minLines="2"
            android:maxLines="4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/board_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
        />
        <app.crossword.yourealwaysbe.view.BoardFullEditView
            android:id="@+id/board_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scrollbars="horizontal|vertical"
            android:background="#000000"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintTop_toBottomOf="@id/clue_line"
            app:layout_constraintBottom_toTopOf="@id/keyboard_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/clue_tabs"
        />
        <app.crossword.yourealwaysbe.view.ClueTabs
            android:id="@+id/clue_tabs"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/clue_line"
            app:layout_constraintBottom_toTopOf="@id/voice_buttons_container"
            app:layout_constraintStart_toEndOf="@id/board_view"
            app:layout_constraintEnd_toEndOf="parent"
        />
        <include
            layout="@layout/voice_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/keyboard_view"
            app:layout_constraintStart_toEndOf="@id/board_view"
            app:layout_constraintEnd_toEndOf="parent"
        />
        <app.crossword.yourealwaysbe.view.ForkyzKeyboard
            android:id="@+id/keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/board_view"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
        />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
