<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/external_tools_settings"
    android:key="externalTools"
>
    <androidx.preference.ListPreference
        android:title="@string/external_dictionary"
        android:summary="@string/external_dictionary_desc"
        android:key="externalDictionary"
        android:defaultValue="1"
        android:entries="@array/external_dictionary_labels"
        android:entryValues="@array/external_dictionary_values"
    />
    <androidx.preference.CheckBoxPreference
        android:title="@string/crossword_solver_enabled"
        android:defaultValue="true"
        android:summary="@string/crossword_solver_enabled_desc"
        android:key="crosswordSolverEnabled"
    />
    <androidx.preference.EditTextPreference
        android:title="@string/chat_gpt_api_key"
        android:summary="@string/chat_gpt_api_key_desc"
        android:dialogTitle="@string/chat_gpt_api_key"
        android:dialogMessage="@string/chat_gpt_api_key_message"
        android:inputType="text"
        android:singleLine="true"
        android:selectAllOnFocus="true"
        android:key="chatGPTAPIKey"
    />
    <androidx.preference.CheckBoxPreference
        android:title="@string/duckduckgo"
        android:defaultValue="true"
        android:summary="@string/duckduckgo_desc"
        android:key="duckDuckGoEnabled"
    />
    <androidx.preference.CheckBoxPreference
        android:title="@string/fifteen_squared"
        android:defaultValue="true"
        android:summary="@string/fifteen_squared_desc"
        android:key="fifteenSquaredEnabled"
    />
</androidx.preference.PreferenceScreen>
