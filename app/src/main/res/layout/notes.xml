<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
    >
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/board_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
        >
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
            >
                <include
                    android:id="@+id/clue_holder"
                    layout="@layout/clue_line_only"
                />
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="vertical"
        >
            <ScrollView
                android:layout_width="fill_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
            >
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                >
                    <TextView
                        android:id="@+id/miniboard_lab"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/board_lab"
                    />
                    <app.crossword.yourealwaysbe.forkyz.view.BoardWordEditView
                        android:id="@+id/miniboard"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:contentDescription="@string/board_lab"
                        android:layout_marginTop="4sp"
                        android:layout_marginBottom="4sp"
                    />
                    <TextView
                        android:id="@+id/scratch_lab"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scratch_lab"
                    />
                    <app.crossword.yourealwaysbe.forkyz.view.BoardEditText
                        android:id="@+id/scratch_miniboard"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:contentDescription="@string/scratch_lab"
                        android:layout_marginTop="4sp"
                        android:layout_marginBottom="4sp"
                    />
                    <TextView
                        android:id="@+id/notes_lab"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notes_lab"
                    />
                    <EditText
                        android:id="@+id/notes_box"
                        android:layout_width="fill_parent"
                        android:layout_height="0dip"
                        android:layout_weight="1.0"
                        android:gravity="top"
                        android:typeface="monospace"
                        android:inputType="text|textMultiLine"
                        android:autofillHints=".AUTOFILL_HINT_NOT_APPLICABLE"
                        android:hint="@string/general_clue_notes"
                    />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/flag_clue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/flag_clue"
                        android:paddingEnd="4dp"
                        android:paddingRight="4dp"
                        android:paddingStart="4dp"
                        android:paddingLeft="4dp"
                    />
                    <TextView
                        android:id="@+id/anagram_source_lab"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/anagram_source_lab"
                    />
                    <app.crossword.yourealwaysbe.forkyz.view.BoardEditText
                        android:id="@+id/anagram_source"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:contentDescription="@string/anagram_source_lab"
                        android:layout_marginTop="4sp"
                        android:layout_marginBottom="4sp"
                    />
                    <TextView
                        android:id="@+id/anagram_solution_lab"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/anagram_solution_lab"
                    />
                    <app.crossword.yourealwaysbe.forkyz.view.BoardEditText
                        android:id="@+id/anagram_solution"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:contentDescription="@string/anagram_solution_lab"
                        android:layout_marginTop="4sp"
                        android:layout_marginBottom="4sp"
                    />
                </LinearLayout>
            </ScrollView>
            <include
                layout="@layout/voice_buttons"
                android:id="@+id/voice_buttons_include"
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
            />
            <app.crossword.yourealwaysbe.forkyz.view.ForkyzKeyboard
                android:id="@+id/keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
            />
        </LinearLayout>
    </LinearLayout>
</layout>
