<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="overdraw"
        android:background="?clueTabsBackground"
    >
            <!-- ignore overdraw because on my LineageOS 17 phone, the theme background
            doesn't always cover board. I couldn't define a custom theme without
            breaking Material You  -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/clue_tabs_tab_layout_0"
                android:layout_width="0dp"
                android:layout_height="50sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/clue_tabs_pager_0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/clue_tabs_tab_layout_1"
            />
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/clue_tabs_pager_0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="fill_vertical"
                app:layout_constraintTop_toBottomOf="@id/clue_tabs_tab_layout_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/clue_tabs_pager_1"
            />
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/clue_tabs_tab_layout_1"
                android:layout_width="0dp"
                android:layout_height="50sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/clue_tabs_pager_1"
                app:layout_constraintStart_toEndOf="@id/clue_tabs_tab_layout_0"
                app:layout_constraintEnd_toEndOf="parent"
                android:visibility="gone"
            />
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/clue_tabs_pager_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/clue_tabs_tab_layout_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/clue_tabs_pager_0"
                app:layout_constraintEnd_toEndOf="parent"
                android:visibility="gone"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
