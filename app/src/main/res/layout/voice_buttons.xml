<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <LinearLayout
        android:id="@+id/voice_buttons_container"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="5dp"
    >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/voice_button"
            android:layout_height="wrap_content"
            android:layout_width="50dp"
            app:icon="@drawable/ic_voice"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:contentDescription="@string/voice_command"
        />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/announce_clue_button"
            android:layout_height="wrap_content"
            android:layout_width="50dp"
            app:icon="@drawable/ic_announce"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:contentDescription="@string/announce_clue_label"
        />
    </LinearLayout>
</layout>
