<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <LinearLayout
        android:id="@+id/layout"
        android:orientation="horizontal"
        android:gravity="center_vertical"
    >
        <Button
            android:id="@+id/prev_clue_button"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            app:icon="@drawable/ic_prev_clue"
            app:iconSize="26sp"
            android:contentDescription="@string/prev_clue"
            android:padding="8dp"
            style="@style/clueLineButtonStyle"
        />
        <TextView
            android:id="@+id/clue_text"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:minLines="2"
            android:maxLines="5"
            android:gravity="center_vertical"
        />
        <Button
            android:id="@+id/next_clue_button"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            app:icon="@drawable/ic_next_clue"
            app:iconSize="26sp"
            android:contentDescription="@string/next_clue"
            android:padding="8dp"
            style="@style/clueLineButtonStyle"
        />
    </LinearLayout>
</layout>



