<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item>
    <!-- set to on scroll elevation to always be raised https://github.com/material-components/material-components-android/blob/master/lib/java/com/google/android/material/appbar/res/animator-v21/m3_appbar_state_list_animator.xml -->
    <objectAnimator
        android:duration="0"
        android:propertyName="elevation"
        android:valueTo="@dimen/appBarElevation"
        android:valueType="floatType"
    />
</item>
</selector>
